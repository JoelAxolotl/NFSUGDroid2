<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rea.nfsug2"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:appCategory="game"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:isGame="true"
        android:label="NFS Underground 2"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" >
        <activity
            android:name="com.rea.nfsug2.LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.rea.nfsug2.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>